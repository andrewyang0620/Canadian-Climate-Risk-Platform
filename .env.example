ENVIRONMENT=local
APP_NAME=canadian-climate-risk-platform
LOG_LEVEL=INFO

LOCAL_BRONZE_PATH=lakehouse/bronze
LOCAL_SILVER_PATH=lakehouse/silver
LOCAL_GOLD_PATH=lakehouse/gold
LOCAL_AUDIT_PATH=lakehouse/audit
LOCAL_PROFILE_PATH=lakehouse/profiles

AWS_REGION=ca-central-1
AWS_PROFILE=default

S3_DATA_LAKE_BUCKET=your-climate-risk-data-lake-bucket
S3_RAW_PREFIX=bronze
S3_PROCESSED_PREFIX=silver
S3_AUDIT_PREFIX=audit
S3_PROFILE_PREFIX=profiles
S3_TEMP_PREFIX=temp

S3_BRONZE_URI=s3://your-climate-risk-data-lake-bucket/bronze/
S3_SILVER_URI=s3://your-climate-risk-data-lake-bucket/silver/
S3_AUDIT_URI=s3://your-climate-risk-data-lake-bucket/audit/

SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=TRANSFORM_ROLE
SNOWFLAKE_WAREHOUSE=CLIMATE_RISK_WH
SNOWFLAKE_DATABASE=CLIMATE_RISK
SNOWFLAKE_SCHEMA=DEV
SNOWFLAKE_THREADS=4

SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

DBT_PROFILES_DIR=/root/.dbt
DBT_TARGET=dev
DBT_PROFILE=climate_risk_snowflake

AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=./airflow
AIRFLOW_WEB_PORT=8081

# Airflow metadata database only.
# This is NOT the analytical warehouse.
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_POSTGRES_DB=airflow

# Optional local PostGIS validation / serving layer.
# Snowflake remains the primary analytical warehouse.
POSTGIS_HOST=localhost
POSTGIS_PORT=5432
POSTGIS_DB=climate_risk
POSTGIS_USER=climate_risk
POSTGIS_PASSWORD=climate_risk

HTTP_TIMEOUT_SECONDS=60
HTTP_MAX_RETRIES=3
SOCRATA_DEFAULT_PAGE_LIMIT=50000
SOCRATA_MIN_PAGE_LIMIT=1000
