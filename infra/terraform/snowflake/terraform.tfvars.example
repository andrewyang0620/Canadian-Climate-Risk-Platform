# Snowflake connection
snowflake_organization_name = "your-organization"
snowflake_account = "your-account-name"
snowflake_user    = "TERRAFORM_SERVICE_USER"

# Use SYSADMIN or a dedicated Terraform role.
# Avoid ACCOUNTADMIN as the default operational role.
snowflake_role = "SYSADMIN"

# Warehouse
warehouse_name = "CLIMATE_RISK_WH"
warehouse_size = "XSMALL"

# Database
database_name = "CLIMATE_RISK"

# Schemas
schema_names = {
  core = "CORE"
  analytics = "ANALYTICS"
  audit = "AUDIT"
}
